# ===========================================
# DELIVER-ME BACKEND ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your actual values
# ===========================================

# ===========================================
# DATABASE MODE (PostgreSQL vs Firestore)
# ===========================================
# true  = Firebase Cloud Firestore (see repositories/, services/firestore_client.py)
# false = PostgreSQL (requires db.init_app in app.py — currently disabled in this branch)
USE_FIREBASE_DB=true

# ===========================================
# PostgreSQL (only when USE_FIREBASE_DB=false)
# ===========================================
DATABASE_URL=postgresql://postgres:1234@localhost:5432/deliver_me

# ===========================================
# Firebase / Firestore (when USE_FIREBASE_DB=true)
# ===========================================
# GCP project that owns Firestore (Firebase console → Project settings)
GCP_PROJECT=backend-deliver-mee

# Local dev: point the Admin SDK at the Firestore emulator (firebase emulators:start --only firestore)
# Leave unset for cloud Firestore.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Service account JSON for cloud Firestore (local or non-GCP runtimes). Not required when
# FIRESTORE_EMULATOR_HOST is set. On Cloud Run, use the service account attached to the service.
GOOGLE_APPLICATION_CREDENTIALS=D:\backend-deliver-me\service_account_key.json

# ===========================================
# FLASK APPLICATION SETTINGS
# ===========================================
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_DEBUG=True

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# ===========================================
# PAYMENT INTEGRATION (STRIPE)
# ===========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ===========================================
# GOOGLE CLOUD SERVICES
# ===========================================
GCS_BUCKET=delivermee_bucket

# ===========================================
# GOOGLE MAPS API
# ===========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===========================================
# EMAIL CONFIGURATION (OPTIONAL)
# ===========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===========================================
# SMS CONFIGURATION (TWILIO)
# ===========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
USE_MOCK_SMS=true

# ===========================================
# PUSH NOTIFICATIONS (OPTIONAL)
# ===========================================
FCM_SERVER_KEY=your_fcm_server_key_here

# ===========================================
# REDIS CONFIGURATION (OPTIONAL)
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# PRODUCTION NOTES
# ===========================================
# 1. Never commit actual .env file to version control
# 2. Use strong, unique secrets for production
# 3. Store secrets securely in production (GCP Secret Manager)
# 4. Deploy Firestore rules and indexes: firebase deploy --only firestore
# 5. Set FLASK_DEBUG=False in production
# 6. Use HTTPS URLs for all external APIs in production
